# Copiá como .env y completá. En Coolify: cargá estas variables en la sección
# "Environment variables" del recurso.

# ── Obligatorias — el servicio NO arranca si falta alguna ──────────────────

# Postgres de la Supabase self-hosted. En la red 'coolify' el host es el nombre
# COMPLETO del contenedor: supabase-db-<uuid-del-recurso-supabase>.
#   postgresql://postgres:PASSWORD@supabase-db-0d1y5zwwvajsdrzyride0awa:5432/postgres
POSTGRES_URL=postgresql://postgres:PASSWORD@supabase-db-0d1y5zwwvajsdrzyride0awa:5432/postgres

# Esquema donde viven las tablas de este servicio (aislado del resto de Supabase).
DB_SCHEMA=cuentas

# Firma/pepper para el hashing y para IDs de sesión. openssl rand -hex 32
SESSION_SECRET=pon_aqui_64_caracteres_hex_aleatorios

# Polar.sh REAL (https://api.polar.sh/v1, org tiklivetts). Opcionales para arrancar;
# /api/checkout y /api/webhooks/polar fallan explícito si faltan.
# POLAR_WEBHOOK_SECRET: polar_whs_ + 32+ chars aleatorios (mismo valor en el webhook de Polar).
POLAR_API_KEY=
POLAR_WEBHOOK_SECRET=
POLAR_PRODUCT_ID_PRO_ANUAL=11e9dfe6-6b0a-4682-b4de-b2606d66fef0
# Plan chico: solo desbloquea el entitlement 'sin-promos' (no el resto de Pro).
POLAR_PRODUCT_ID_SIN_PROMOS=e1d5cdce-7f7e-4681-b161-3f409807d85c

# ── Opcionales (tienen default) ───────────────────────────────────────────
PORT=4000
# Horas de validez de una sesión.
SESSION_HOURS=720
# true si va detrás de un reverse proxy (lee X-Forwarded-For). Caddy => true.
TRUST_PROXY=true
# Orígenes permitidos para CORS de /api/* (la app Electron llama desde file://
# u origin nulo; se permite siempre 'null'). Coma-separado, "*" permite todo.
PUBLIC_ORIGIN=*
# Cada cuántas horas corre el job de reconciliación con Polar.
RECONCILE_EVERY_HOURS=6
# URL pública de este servicio (para armar success_url del checkout).
PUBLIC_URL=https://cuentas.tiklivetts.es
